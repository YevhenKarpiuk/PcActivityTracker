<Window x:Class="PcActivityTracker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="PcActivityTracker"
        Icon="Assets/PcActivityTracker.ico"
        Width="1240"
        Height="800"
        MinWidth="1020"
        MinHeight="660"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <Grid Margin="12">
        <TabControl>
            <TabItem Header="Сегодня">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="260" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="12" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Активное время" Foreground="Gray" />
                                <TextBlock Text="{Binding ActiveTimeText}" FontSize="28" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Простой" Foreground="Gray" />
                                <TextBlock Text="{Binding IdleTimeText}" FontSize="28" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Самая активная программа" Foreground="Gray" />
                                <TextBlock Text="{Binding MostUsedProgramText}" FontSize="24" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Button x:Name="PauseButton" Content="Пауза" Click="PauseButton_Click" />
                                <Button Content="Обновить" Click="RefreshButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Padding="8" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="Период с" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <DatePicker x:Name="ReportStartDatePicker" Width="140" />
                            <TextBlock Text="по" VerticalAlignment="Center" Margin="10,0,4,0" />
                            <DatePicker x:Name="ReportEndDatePicker" Width="140" />
                            <TextBlock Text="Программа" VerticalAlignment="Center" Margin="14,0,4,0" />
                            <TextBox x:Name="ReportProgramFilterTextBox" Width="150" />
                            <TextBlock Text="Категория" VerticalAlignment="Center" Margin="14,0,4,0" />
                            <TextBox x:Name="ReportCategoryFilterTextBox" Width="150" />
                            <TextBlock Text="Окно" VerticalAlignment="Center" Margin="14,0,4,0" />
                            <TextBox x:Name="ReportWindowFilterTextBox" Width="220" />
                            <Button Content="Обновить графики" Click="RefreshButton_Click" Margin="14,0,0,0" />
                        </WrapPanel>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Padding="8" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Топ программ за сегодня" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <lvc:PieChart Series="{Binding ProgramSeries}" LegendPosition="Right" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Padding="8" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Программы" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <DataGrid ItemsSource="{Binding ProgramUsage}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Программа" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="Время" Binding="{Binding DurationFormatted}" Width="110" />
                                        <DataGridTextColumn Header="%" Binding="{Binding PercentFormatted}" Width="70" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3" Padding="8" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Журнал активности за сегодня" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding TodayRecords}" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Начало" Binding="{Binding StartTime, StringFormat=HH:mm:ss}" Width="85" />
                                    <DataGridTextColumn Header="Конец" Binding="{Binding EndTime, StringFormat=HH:mm:ss}" Width="85" />
                                    <DataGridTextColumn Header="Время" Binding="{Binding DurationFormatted}" Width="95" />
                                    <DataGridTextColumn Header="Программа" Binding="{Binding ProcessName}" Width="120" />
                                    <DataGridTextColumn Header="Домен" Binding="{Binding BrowserDomain}" Width="150" />
                                    <DataGridTextColumn Header="Окно" Binding="{Binding WindowTitle}" Width="*" />
                                    <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="130" />
                                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="История">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Padding="8" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="С" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <DatePicker x:Name="HistoryStartDatePicker" Width="140" />
                            <TextBlock Text="по" VerticalAlignment="Center" Margin="10,0,4,0" />
                            <DatePicker x:Name="HistoryEndDatePicker" Width="140" />
                            <TextBlock Text="Программа" VerticalAlignment="Center" Margin="14,0,4,0" />
                            <TextBox x:Name="HistoryProgramFilterTextBox" Width="150" />
                            <TextBlock Text="Категория" VerticalAlignment="Center" Margin="14,0,4,0" />
                            <TextBox x:Name="HistoryCategoryFilterTextBox" Width="150" />
                            <TextBlock Text="Окно" VerticalAlignment="Center" Margin="14,0,4,0" />
                            <TextBox x:Name="HistoryWindowFilterTextBox" Width="220" />
                            <Button Content="Обновить историю" Click="LoadHistoryButton_Click" Margin="14,0,0,0" />
                            <Button Content="Удалить по отбору" Click="DeleteFilteredHistoryButton_Click" />
                            <Button Content="Экспорт CSV" Click="ExportCsvButton_Click" />
                            <Button Content="Экспорт JSON" Click="ExportJsonButton_Click" />
                        </WrapPanel>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding HistoryRecords}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding StartTime, StringFormat=yyyy-MM-dd}" Width="105" />
                            <DataGridTextColumn Header="Начало" Binding="{Binding StartTime, StringFormat=HH:mm:ss}" Width="85" />
                            <DataGridTextColumn Header="Конец" Binding="{Binding EndTime, StringFormat=HH:mm:ss}" Width="85" />
                            <DataGridTextColumn Header="Время" Binding="{Binding DurationFormatted}" Width="95" />
                            <DataGridTextColumn Header="Программа" Binding="{Binding ProcessName}" Width="120" />
                            <DataGridTextColumn Header="Домен" Binding="{Binding BrowserDomain}" Width="150" />
                            <DataGridTextColumn Header="Окно" Binding="{Binding WindowTitle}" Width="*" />
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="130" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Программы">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Row="0" Grid.ColumnSpan="2" Padding="8" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8">
                        <StackPanel>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Период с" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <DatePicker x:Name="ProgramChartStartDatePicker" Width="140" />
                                <TextBlock Text="по" VerticalAlignment="Center" Margin="10,0,4,0" />
                                <DatePicker x:Name="ProgramChartEndDatePicker" Width="140" />
                                <TextBlock Text="Данные" VerticalAlignment="Center" Margin="14,0,4,0" />
                                <ComboBox x:Name="ProgramChartGroupByComboBox" Width="150" SelectedValuePath="Tag" SelectedIndex="0">
                                    <ComboBoxItem Content="Программа" Tag="ProcessName" />
                                    <ComboBoxItem Content="Категория" Tag="Category" />
                                    <ComboBoxItem Content="Домен" Tag="BrowserDomain" />
                                    <ComboBoxItem Content="Окно" Tag="WindowTitle" />
                                    <ComboBoxItem Content="Статус" Tag="Status" />
                                    <ComboBoxItem Content="День" Tag="Day" />
                                </ComboBox>
                                <TextBlock Text="Топ" VerticalAlignment="Center" Margin="14,0,4,0" />
                                <TextBox x:Name="ProgramChartTopItemsTextBox" Width="50" />
                                <CheckBox x:Name="ProgramChartIncludeIdleCheckBox" Content="Включать простой" VerticalAlignment="Center" Margin="14,0,0,0" />
                                <Button Content="Построить" Click="RefreshProgramChartButton_Click" Margin="14,0,0,0" />
                                <Button Content="Сохранить настройки графика" Click="SaveProgramChartSettingsButton_Click" />
                                <Button Content="Загрузить настройки" Click="LoadProgramChartSettingsButton_Click" />
                            </WrapPanel>
                            <WrapPanel VerticalAlignment="Center" Margin="0,8,0,0">
                                <TextBlock Text="Программа" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox x:Name="ProgramChartProgramFilterTextBox" Width="150" />
                                <TextBlock Text="Категория" VerticalAlignment="Center" Margin="14,0,4,0" />
                                <TextBox x:Name="ProgramChartCategoryFilterTextBox" Width="150" />
                                <TextBlock Text="Домен" VerticalAlignment="Center" Margin="14,0,4,0" />
                                <TextBox x:Name="ProgramChartDomainFilterTextBox" Width="150" />
                                <TextBlock Text="Окно" VerticalAlignment="Center" Margin="14,0,4,0" />
                                <TextBox x:Name="ProgramChartWindowFilterTextBox" Width="220" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Padding="8" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding ProgramChartTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <lvc:PieChart Grid.Row="1" Series="{Binding ProgramChartSeries}" LegendPosition="Right" MinHeight="260" />
                        </Grid>
                    </Border>
                    <DataGrid Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ProgramChartUsage}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Значение" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Время" Binding="{Binding DurationFormatted}" Width="110" />
                            <DataGridTextColumn Header="%" Binding="{Binding PercentFormatted}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Категории">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Row="0" Grid.ColumnSpan="2" Content="Обновить графики" Click="RefreshButton_Click" HorizontalAlignment="Left" Margin="0,0,0,8" />
                    <Border Grid.Row="1" Grid.Column="0" Padding="8" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" Margin="0,0,8,0">
                        <lvc:PieChart Series="{Binding CategorySeries}" LegendPosition="Right" />
                    </Border>
                    <DataGrid Grid.Row="1" Grid.Column="1" ItemsSource="{Binding CategoryUsage}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Категория" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Время" Binding="{Binding DurationFormatted}" Width="110" />
                            <DataGridTextColumn Header="%" Binding="{Binding PercentFormatted}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Настройки">
                <ScrollViewer Margin="8">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="Настройки сбора активности" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="Порог простоя, секунд" />
                        <TextBox x:Name="IdleThresholdTextBox" Width="160" HorizontalAlignment="Left" />
                        <TextBlock Text="Интервал проверки активного окна, секунд" Margin="0,8,0,0" />
                        <TextBox x:Name="PollingIntervalTextBox" Width="160" HorizontalAlignment="Left" />
                        <CheckBox x:Name="HideBrowserTitlesCheckBox" Content="Скрывать заголовки окон браузеров" />
                        <CheckBox x:Name="AutostartCheckBox" Content="Запускать вместе с Windows" />

                        <TextBlock Text="Правила отключения отслеживания" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,8" />
                        <TextBlock Text="Исключённые процессы, по одному на строку. Пример: telegram.exe" />
                        <TextBox x:Name="ExcludedProcessesTextBox" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto" />

                        <TextBlock Text="Исключённые окна по точному названию, по одному на строку" Margin="0,12,0,0" />
                        <TextBox x:Name="ExcludedWindowTitlesTextBox" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto" />

                        <TextBlock Text="Исключённые окна по шаблону. Поддерживается * и ?, также regex:..." Margin="0,12,0,0" />
                        <TextBox x:Name="ExcludedWindowTitlePatternsTextBox" AcceptsReturn="True" Height="100" VerticalScrollBarVisibility="Auto" ToolTip="Примеры: *Пароли*; *Incognito*; regex:^.*секрет.*$" />

                        <TextBlock Text="Исключённые сайты/домены для браузеров, по одному на строку. Пример: youtube.com или *.example.com" Margin="0,12,0,0" />
                        <TextBox x:Name="ExcludedBrowserDomainsTextBox" AcceptsReturn="True" Height="100" VerticalScrollBarVisibility="Auto" />
                        <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0" Text="Домены читаются из адресной строки через Windows UI Automation. Если браузер или страница не отдаёт адресную строку, правило по домену может не сработать; правила по процессу и заголовку окна продолжают работать." />

                        <TextBlock Text="Категории программ. Формат: process.exe=Категория" Margin="0,18,0,0" />
                        <TextBox x:Name="CategoriesTextBox" AcceptsReturn="True" Height="220" VerticalScrollBarVisibility="Auto" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Сохранить настройки" Click="SaveSettingsButton_Click" />
                            <Button Content="Очистить историю" Click="ClearHistoryButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
