<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\PcActivityTracker.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Assets\PcActivityTracker.ico" />
    <Resource Include="Assets\PcActivityTracker.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PcActivityTracker.Core\PcActivityTracker.Core.csproj" />
    <ProjectReference Include="..\PcActivityTracker.Data\PcActivityTracker.Data.csproj" />
    <ProjectReference Include="..\PcActivityTracker.Windows\PcActivityTracker.Windows.csproj" />
  </ItemGroup>
</Project>
