{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PcActivityTracker: Windows Release build + tests",
      "type": "process",
      "command": "cmd.exe",
      "args": ["/d", "/c", "${workspaceFolder}\\build_windows.cmd"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "PcActivityTracker: Windows Release build (incremental)",
      "type": "process",
      "command": "cmd.exe",
      "args": ["/d", "/c", "${workspaceFolder}\\build_windows.cmd", "incremental"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "PcActivityTracker: Run Windows Release",
      "type": "process",
      "command": "cmd.exe",
      "args": ["/d", "/c", "${workspaceFolder}\\run_windows.cmd"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "PcActivityTracker: Core tests (C:/tools toolchain)",
      "type": "process",
      "command": "C:\\tools\\cmake\\bin\\cmake.exe",
      "args": ["--workflow", "--preset", "windows-core-tests"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"]
    }
  ]
}
