{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-release",
      "displayName": "Windows x64 Release (MSYS2 UCRT64 + Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PCAT_BUILD_APP": "ON",
        "PCAT_BUILD_DATA": "ON",
        "PCAT_BUILD_TESTS": "ON",
        "PCAT_FETCH_DEPS": "ON",
        "PCAT_STRICT_WARNINGS": "OFF",
        "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe",
        "CMAKE_RC_COMPILER": "C:/msys64/ucrt64/bin/windres.exe",
        "CMAKE_PREFIX_PATH": "C:/msys64/ucrt64"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows x64 Debug (MSYS2 UCRT64 + Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PCAT_BUILD_APP": "ON",
        "PCAT_BUILD_DATA": "ON",
        "PCAT_BUILD_TESTS": "ON",
        "PCAT_FETCH_DEPS": "ON",
        "PCAT_STRICT_WARNINGS": "OFF",
        "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe",
        "CMAKE_RC_COMPILER": "C:/msys64/ucrt64/bin/windres.exe",
        "CMAKE_PREFIX_PATH": "C:/msys64/ucrt64"
      }
    },
    {
      "name": "ninja-debug",
      "displayName": "Ninja Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PCAT_BUILD_APP": "ON",
        "PCAT_BUILD_TESTS": "ON",
        "PCAT_FETCH_DEPS": "ON"
      }
    },
    {
      "name": "ninja-release",
      "displayName": "Ninja Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PCAT_BUILD_APP": "ON",
        "PCAT_BUILD_TESTS": "ON",
        "PCAT_FETCH_DEPS": "ON"
      }
    },
    {
      "name": "core-tests-system-sqlite",
      "displayName": "Core/data/report tests only",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/core-tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PCAT_BUILD_APP": "OFF",
        "PCAT_BUILD_DATA": "ON",
        "PCAT_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-release"
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug"
    },
    {
      "name": "debug",
      "configurePreset": "ninja-debug"
    },
    {
      "name": "release",
      "configurePreset": "ninja-release"
    },
    {
      "name": "core-tests",
      "configurePreset": "core-tests-system-sqlite"
    }
  ],
  "testPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "core-tests",
      "configurePreset": "core-tests-system-sqlite",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
